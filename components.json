{
  "$schema": "https://ui.shadcn.com/schema.json",
  "style": "new-york",
  "rsc": false,
  "tsx": true,
  "tailwind": {
    "config": "tailwind.config.js",
    "css": "src/index.css",
    "baseColor": "zinc",
    "cssVariables": true,
    "prefix": ""
  },
  "iconLibrary": "radix",
  "aliases": {
    "components": "src/shared/components",
    "utils": "src/lib/utils",
    "ui": "src/shared/components/ui",
    "lib": "src/lib",
    "hooks": "src/shared/hooks"
  },
  "registries": {
    "@magicui": "https://magicui.design/r/{name}"
  }
}
